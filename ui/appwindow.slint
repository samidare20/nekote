import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "nekote";
    min-width: 600px;
    min-height: 400px;

    in-out property <string> folder_path: "";
    in-out property <[string]> file_list: [];

    callback open_folder_clicked();

    VerticalBox {
        padding: 10px;
        spacing: 10px;

        HorizontalBox {
            spacing: 10px;

            Button {
                text: "폴더 열기";
                clicked => {
                    root.open_folder_clicked();
                }
            }

            Text {
                text: root.folder_path == "" ? "선택된 폴더 없음" : root.folder_path;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        ScrollView {
            VerticalBox {
                padding: 0px;
                spacing: 4px;
                alignment: start;

                for file in root.file_list : Text {
                    text: file;
                    font-size: 14px;
                }
            }
        }
    }
}

